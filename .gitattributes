# Handle line endings automatically for files detected as text 
# and leave binary files untouched.
* text=auto

# Explicitly declare text files you want to always be normalized 
# and converted to native line endings on checkout.
*.rs text
*.toml text
*.md text
*.js text
*.ts text
*.tsx text
*.json text
*.css text
*.html text
*.sql text
*.cql text
*.yml text
*.yaml text
*.sh text eol=lf
*.bat text eol=crlf

# Denote all files that are truly binary and should not be modified.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mov binary
*.mp4 binary
*.pdf binary
