# ── ScyllaDB ──────────────────────────────────────────────────────────────────
# SCYLLA_NODES is used by the app; SCYLLA_HOST is kept for legacy local setups.
SCYLLA_NODES=127.0.0.1:9042
SCYLLA_HOST=127.0.0.1:9042

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Used by the application and sqlx for user/auth data.
DATABASE_URL=postgres://trading:trading@localhost:5432/trading

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092

# ── Auth ──────────────────────────────────────────────────────────────────────
# Change this to a strong random value in production!
JWT_SECRET=super-secret-key-change-me

# ── Backtest ──────────────────────────────────────────────────────────────────
BACKTEST_FETCH_MISSING=false
BACKTEST_MIN_CONFIDENCE=0.01

# ── Historical sync ───────────────────────────────────────────────────────────
HIST_SYNC_ON_START=false
HIST_SYNC_DAYS=30
HIST_SYNC_INTERVAL=1m
