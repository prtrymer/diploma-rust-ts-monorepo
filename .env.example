# ── ScyllaDB ──────────────────────────────────────────────────────────────────
# SCYLLA_NODES is used by the app; SCYLLA_HOST is kept for legacy local setups.
SCYLLA_NODES=127.0.0.1:9042
SCYLLA_HOST=127.0.0.1:9042

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Used by the application and sqlx for user/auth data.
DATABASE_URL=postgres://trading:trading@localhost:5432/trading

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092

# ── Auth ──────────────────────────────────────────────────────────────────────
# Change this to a strong random value in production!
JWT_SECRET=super-secret-key-change-me

# ── Backtest ──────────────────────────────────────────────────────────────────
BACKTEST_FETCH_MISSING=false
BACKTEST_MIN_CONFIDENCE=0.1

# ── Historical sync ───────────────────────────────────────────────────────────
HIST_SYNC_ON_START=false
HIST_SYNC_DAYS=30
HIST_SYNC_INTERVAL=1m

# ── HTX (live-виконання carry-кошика, бінарник htx-exec) ─────────────────────
# Ключ створюй на https://www.htx.com/apikey з правами ТІЛЬКИ читання + трейд,
# БЕЗ права на вивід коштів. Прив'яжи до своєї IP-адреси: ключ без прив'язки
# HTX автоматично деактивує через 90 днів. Реальні значення — тільки в .env
# (він у .gitignore), сюди нічого не вписувати.
HTX_ACCESS_KEY=
HTX_SECRET_KEY=
# Хости за замовчуванням: спот api.huobi.pro (працює і api.htx.com),
# USDT-M своп api.hbdm.com. Міняти зазвичай не треба.
#HTX_SPOT_HOST=api.huobi.pro
#HTX_SWAP_HOST=api.hbdm.com
# Головний рубильник: доки не true — `htx-exec execute` відмовляється слати
# ордери. `htx-exec plan` (dry-run) працює завжди.
HTX_TRADING_ENABLED=false
